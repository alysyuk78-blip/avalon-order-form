{
  "version": 2,
  "buildCommand": "npm run build:admin",
  "redirects": [
    {
      "source": "/calc",
      "destination": "/calc/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/calc/(.*)",
      "destination": "https://avalon-calculator.vercel.app/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
